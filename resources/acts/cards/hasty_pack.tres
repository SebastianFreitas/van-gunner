[ext_resource type="Script" path="res://scripts/run/act_card_effect.gd" id="2"]
[ext_resource type="Script" path="res://scripts/run/effects/enemy_speed_mult_effect.gd" id="3"]
[ext_resource type="Script" path="res://scripts/run/effects/enemy_loot_bonus_effect.gd" id="4"]
[ext_resource type="Texture2D" path="res://scenes/acts/cards/hasty_pack.svg" id="5"]

[sub_resource type="Resource" id="eff_speed"]
script = ExtResource("3")
