[resource]
script = ExtResource("1")
id = &"road_lighter"
display_name = "Road Lighter"
description = "Warm your hands and patch the van. Restores 10% hull on pickup."
icon = ExtResource("4")
effects = Array[ExtResource("2")]([SubResource("Resource_lighter_heal")])
