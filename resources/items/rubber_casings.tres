[gd_resource type="Resource" script_class="ItemDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/items/item_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/items/item_effect.gd" id="2"]
[ext_resource type="Script" path="res://scripts/items/effects/gun_stat_modifier_effect.gd" id="3"]
[ext_resource type="Script" path="res://scripts/combat/stat_modifier.gd" id="4"]
[ext_resource type="Texture2D" path="res://scenes/items/rubber_casings.svg" id="5"]

[sub_resource type="Resource" id="Resource_rubber_bounce_modifier"]
script = ExtResource("4")
stat_name = &"max_bounces"
mode = 0
value = 1.0
id = &"rubber_casings_bounces"

[sub_resource type="Resource" id="Resource_rubber_bounce_effect"]
script = ExtResource("3")
modifier = SubResource("Resource_rubber_bounce_modifier")

[sub_resource type="Resource" id="Resource_rubber_retention_modifier"]
script = ExtResource("4")
stat_name = &"bounce_speed_retention"
mode = 1
value = 1.35
id = &"rubber_casings_retention"

[sub_resource type="Resource" id="Resource_rubber_retention_effect"]
script = ExtResource("3")
modifier = SubResource("Resource_rubber_retention_modifier")

[resource]
script = ExtResource("1")
id = &"rubber_casings"
display_name = "Rubber Casings"
description = "Springy casings. One extra bounce, and ricochets keep far more speed."
icon = ExtResource("5")
kind = 1
effects = Array[ExtResource("2")]([SubResource("Resource_rubber_bounce_effect"), SubResource("Resource_rubber_retention_effect")])
