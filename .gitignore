# Python
__pycache__/
*.py[cod]

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
/android/

# Smoke test output; the committed baseline lives in fingerprint.baseline.txt
tools/smoke/fingerprint.txt
tools/smoke/van_kit_golden.current.txt

# Scene dump output; the committed baseline lives in van.baseline.txt
tools/scene_dump/van.txt

# Claude Code: session worktrees and the context handoff stay local
.claude/worktrees/
.claude/handoff.md
.claude/specs/

# Plans: HERE binds this checkout's plan; autoplan keeps its run logs locally
.claude/plans/HERE
.claude/autoplan/

# Written per run by tools/try.py (separate user:// profile) and
# tools/smoke.py --shots (no-focus window); never committed
/override.cfg

# Godot export presets hold per-machine output paths; each checkout keeps its own
export_presets.cfg

# Generated by tools/gen_context.py at session start and by try.py; never committed, so parallel branches never conflict on it.
docs/PROJECT_MAP.md
